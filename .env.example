# Solynx Stripe Checkout Links
# Copy these to Vercel → Project → Settings → Environment Variables
# Do NOT commit real values to GitHub

STRIPE_SCOUT_MONTHLY=https://buy.stripe.com/9B614n1VSfqA6lp5g25sA0d
STRIPE_SCOUT_ANNUAL=https://buy.stripe.com/4gMfZheIEceo6lpcIu5sA0g
STRIPE_PROWLER_MONTHLY=https://buy.stripe.com/14A28raso6U4fVZfUG5sA0h
STRIPE_PROWLER_ANNUAL=https://buy.stripe.com/3cI28rdEA6U4fVZ23Q5sA0i

# SOLYNX Live Experience — GHL Automation Webhook
# Set this in Vercel → Project → Settings → Environment Variables
# Get the URL from GHL → Automations → Webhook Trigger → Copy URL
GHL_LIVE_EXPERIENCE_WEBHOOK_URL=

# Lions All-Star Football Game — Lead Capture Webhook
# Set this in Vercel → Project → Settings → Environment Variables
# Get the URL from GHL → Automations → Webhook Trigger → Copy URL
LIONS_ALL_STAR_WEBHOOK_URL=

# Digital Media intake — dedicated scoped configuration, disabled by default.
# Store the token only in the deployment's secret environment, never in source.
# Verify location, task owner and workflow membership before enabling.
# Workflow must notify the media team and acknowledge the requester.
# A successful workflow enrollment alone does not prove message delivery.
# A dedicated durable Redis REST store must be approved and configured. The
# handler uses atomic SET NX before any CRM write and does not expire a failed
# reservation; uncertain attempts require manual reconciliation. Never reuse
# the read-only SOLYNX MCP integration. Rate/abuse controls need release review.
SOLYNX_MEDIA_INTAKE_ENABLED=false
SOLYNX_MEDIA_CRM_TOKEN=
SOLYNX_MEDIA_LOCATION_ID=
SOLYNX_MEDIA_TASK_OWNER_ID=
SOLYNX_MEDIA_WORKFLOW_ID=
# HTTPS root of an approved *.upstash.io Redis REST database; secret stays in Vercel.
SOLYNX_MEDIA_GUARD_REST_URL=
SOLYNX_MEDIA_GUARD_REST_TOKEN=
# Comma-separated exact origins; no wildcard or trailing slash.
SOLYNX_MEDIA_ALLOWED_ORIGINS=
